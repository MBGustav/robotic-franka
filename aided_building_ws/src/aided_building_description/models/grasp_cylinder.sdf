<?xml version="1.0"?>
<!-- Soldering-iron-like handle: 20 mm diameter, 120 mm long, 50 g, lying along x
     (across the finger closing direction y) once spawned by sim.launch.py. -->
<sdf version="1.9">
  <model name="grasp_cylinder">
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>6.125e-5</ixx><iyy>6.125e-5</iyy><izz>2.5e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.01</radius><length>0.12</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.01</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.8 0.2 0.1 1</ambient><diffuse>0.8 0.2 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
