<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3">

  <xacro:arg name="xyz" default="0 0 0"/>
  <xacro:arg name="rpy" default="0 0 0"/>

  <xacro:arg name="connected_to" default=""/>
  <xacro:arg name="hand" default="true"/>
  <xacro:arg name="include_self_collision_geometry" default="false"/>

  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <origin xyz="$(arg xyz)" rpy="$(arg rpy)"/>
    <parent link="world"/>
    <child link="fr3_link0"/>
  </joint>

  <xacro:include filename="$(find franka_description)/robots/fr3/fr3.urdf.xacro"/>

  <ros2_control name="FrankaSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="fr3_joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-0.785398</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint4">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-2.356194</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint5">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint6">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">1.570796</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint7">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.785398</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- Franka Hand: only finger_joint1 is commanded (finger position = width / 2).
         finger_joint2 is a URDF mimic joint; it must be listed here with state
         interfaces only, otherwise gz_ros2_control does not drive it.
         They start 0.5 mm below the 0.04 limit: Gazebo sticks a joint resting on it. -->
    <joint name="fr3_finger_joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0395</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_finger_joint2">
      <state_interface name="position">
        <param name="initial_value">0.0395</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find aided_building_description)/config/controllers.yaml</parameters>
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
  </gazebo>

  <!-- Rubber finger pads (same values as the official franka_gazebo). -->
  <gazebo reference="fr3_leftfinger">
    <collision>
      <max_contacts>10</max_contacts>
      <surface>
        <contact><ode><max_vel>0</max_vel><min_depth>0.001</min_depth></ode></contact>
        <friction><ode><mu>1.13</mu><mu2>1.13</mu2></ode></friction>
      </surface>
    </collision>
  </gazebo>
  <gazebo reference="fr3_rightfinger">
    <collision>
      <max_contacts>10</max_contacts>
      <surface>
        <contact><ode><max_vel>0</max_vel><min_depth>0.001</min_depth></ode></contact>
        <friction><ode><mu>1.13</mu><mu2>1.13</mu2></ode></friction>
      </surface>
    </collision>
  </gazebo>

</robot>
