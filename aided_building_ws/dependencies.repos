repositories:
  franka_description:
    type: git
    url: https://github.com/frankarobotics/franka_description.git
    # Same version pinned by franka_ros2 (jazzy); `main` may break the xacro.
    version: 2.9.0
  franka_ros2:
    type: git
    url: https://github.com/frankarobotics/franka_ros2.git
    # Needed for franka_msgs (sim + real) and franka_gripper (real only).
    version: jazzy
  gz_ros2_control:
    type: git
    url: https://github.com/ros-controls/gz_ros2_control.git
    version: jazzy
  libfranka:
    type: git
    url: https://github.com/frankarobotics/libfranka.git
    # Real robot only. Same version pinned by franka_ros2 (jazzy); it must also
    # be compatible with the robot's system version (check in Desk).
    version: 0.20.5
